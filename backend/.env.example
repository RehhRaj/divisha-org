# Local development
DJANGO_DEBUG=1

# Production (DJANGO_DEBUG=0 is the default)
# DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# DJANGO_ALLOWED_HOSTS=divisha.org,.divisha.org,gtbtax.pythonanywhere.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://divisha.org,https://*.divisha.org
# DJANGO_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_ADMIN_URL=my-secret-admin/
# DJANGO_LOG_LEVEL=WARNING

# Optional
# DJANGO_POS_DEMO=1                     # hosted POS demo (off by default)
# DJANGO_DB_PATH=/path/to/db.sqlite3
